# Application
APP_NAME=CodePilot OS API
APP_VERSION=0.1.0
ENVIRONMENT=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000"]

# Infrastructure (local development defaults only; do not use production credentials here)
DATABASE_URL=postgresql+asyncpg://codepilot:codepilot@localhost:5432/codepilot
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_BUCKET=

# Future integrations - leave blank until their implementation phase
OPENAI_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
